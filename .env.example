# ── App ──────────────────────────────────────────────────────────────
ENVIRONMENT=development                # development | staging | production
SECRET_KEY=change-me-to-a-random-64-char-string   # used for JWT signing
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000

# ── Database (PostgreSQL) ───────────────────────────────────────────
POSTGRES_USER=football
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ai_football_analyst
POSTGRES_HOST=db                       # service name in docker-compose; use
                                        # your Render Postgres host in prod
POSTGRES_PORT=5432
# Connection pool
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
# Full DSN is assembled from the above in app/core/config.py, but can be
# overridden directly if your host gives you a single connection string:
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/dbname

# ── Redis (cache / queues) ──────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ── Auth ─────────────────────────────────────────────────────────────
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ALGORITHM=HS256

# ── Football data provider ──────────────────────────────────────────
# Which provider implementation to use behind the FootballDataProvider
# interface. Only "sportmonks" is implemented so far; "null" is a
# no-network stub useful for local dev/tests without hitting a real API.
FOOTBALL_DATA_PROVIDER=sportmonks      # sportmonks | null
SPORTMONKS_API_KEY=                    # required once FOOTBALL_DATA_PROVIDER=sportmonks
SPORTMONKS_BASE_URL=https://api.sportmonks.com/v3/football

# Comma-separated Sportmonks league IDs to sync. Starts intentionally
# narrow (top 5 European leagues + Argentina primera división); expand
# this list later without touching any code.
SPORTMONKS_LEAGUE_IDS=8,564,384,82,301,636

# ── LLM provider (AI explanations / chat — wired in Phase 7) ────────
LLM_PROVIDER=anthropic                 # abstracted; swappable later
LLM_API_KEY=
LLM_MODEL=

# ── Notifications (Phase 5+) ────────────────────────────────────────
NOTIFICATIONS_ENABLED=false

# ── Scheduler (Phase 5 wires the real orchestrator; these exist now so
#    that phase doesn't need to touch configuration again) ─────────────
TIMEZONE=UTC
DAILY_ANALYSIS_HOUR=6                  # local hour, in TIMEZONE, to run the daily orchestrator

# ── Logging ──────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# Phase 3 - real football data ingestion
# Set to sportmonks only when you have a valid licensed Sportmonks API token.
SPORTMONKS_API_KEY=
# Comma-separated Sportmonks league IDs. Empty = all leagues available to the plan.
SPORTMONKS_LEAGUE_IDS=

# Phase 7 AI Analyst
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.anthropic.com
